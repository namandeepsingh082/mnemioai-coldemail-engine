# OpenRouter API key for free (":free"-suffixed) models used to write/personalize
# emails and classify replies. The system runs fully without one (deterministic
# template + keyword-classifier fallback) so you don't need a paid API to seed
# and run the full 10,000-contact simulation.
OPENROUTER_API_KEY=

# Free model IDs (must end in ":free"). Change if a given free slot is retired
# or rate-limited on openrouter.ai; the app only requires the ":free" suffix.
OPENROUTER_WRITER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_CLASSIFIER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Path to the SQLite database file.
DB_PATH=./data/coldemail.db

# Port for the reporting dashboard / API server.
PORT=4000
